# Flask configurations
FLASK_SECRET_KEY=keyway-super-secret-development-key-12345
FLASK_DEBUG=True
FLASK_RUN_PORT=5000

# Security parameters
PBKDF2_ITERATIONS=480000
REVEAL_RATE_LIMIT_PER_MINUTE=10
HEALTHCHECK_TIMEOUT_SECONDS=5

# Database Configuration (Used by Docker Compose)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=keyway

# Redis session URL (Used by Docker Compose)
SESSION_REDIS_URL=redis://localhost:6379/0
